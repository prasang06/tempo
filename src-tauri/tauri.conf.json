{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tempo",
  "version": "0.1.0",
  "identifier": "dev.tempo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "tempo",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "A quiet Pomodoro timer and task list",
    "longDescription": "tempo is a local-first Pomodoro timer and lightweight task manager with independent floating overlays, built for the Linux desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "desktopTemplate": "../packaging/tempo.desktop"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3"
        ],
        "desktopTemplate": "../packaging/tempo.desktop"
      }
    }
  }
}
